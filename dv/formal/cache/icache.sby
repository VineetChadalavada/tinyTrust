[options]
mode bmc
depth 26
# expect pass, not pass,fail. run.ps1 keys off the exit code, and sby treats
# an "expected" FAIL as a clean exit (see the note in dv/formal/runchecks.py)
# -- so pass,fail would report a real counterexample as success.
expect pass

[engines]
abc bmc3

[script]
read -sv cache_fv.sv
read -sv cache.v
read -sv sram_1p_bm.v
prep -top cache_fv -flatten
memory_map
opt -fast

[files]
cache_fv.sv
../../../rtl/cache/cache.v
../../models/sram_1p_bm.v
